<Window x:Class="GameBox.Views.MessagingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📨 Messaging Service" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        Background="{StaticResource BackgroundLightBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="📨 Messaging Service" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Ready to connect" 
                               FontSize="14" Foreground="{StaticResource TextLightBrush}" Opacity="0.9"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="Close" Style="{StaticResource DangerButtonStyle}" 
                        Click="Close_Click" Margin="5"/>
            </Grid>
        </Border>

        <!-- Message Display Area -->
        <Border Grid.Row="1" Background="White" Margin="10" 
                BorderBrush="{StaticResource PrimaryBlueBrush}" BorderThickness="2"
                CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="MessageScrollViewer">
                <StackPanel x:Name="MessagePanel" Margin="10">
                    <!-- Messages will be added here -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Connection Panel -->
        <Border Grid.Row="2" Background="{StaticResource AccentGradient}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Connect to:" FontSize="14" 
                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="FruitCodeTextBox" FontSize="14" 
                         Padding="5" VerticalAlignment="Center" 
                         Text="" />
                <Button Grid.Column="2" Content="Connect" Style="{StaticResource MenuButtonStyle}" 
                        Click="Connect_Click" Margin="5,0,0,0" Padding="15,5"/>
            </Grid>
        </Border>

        <!-- Message Input Panel -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundDarkBrush}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" x:Name="MessageTextBox" FontSize="14" 
                         Padding="5" VerticalAlignment="Center" 
                         KeyDown="MessageTextBox_KeyDown"
                         Text="" />
                <Button Grid.Column="1" Content="Send" Style="{StaticResource SuccessButtonStyle}" 
                        Click="Send_Click" Margin="5,0,0,0" Padding="20,5"/>
            </Grid>
        </Border>
    </Grid>
</Window>

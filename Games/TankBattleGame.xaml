<Window x:Class="GameBox.Games.TankBattleGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tank Battle Online" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown"
        Background="{StaticResource BackgroundLightBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="🚗 Tank Battle Online" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Connecting..." 
                               FontSize="14" Foreground="{StaticResource TextLightBrush}" Opacity="0.9"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0">
                    <TextBlock Text="Your Health:" FontSize="12" 
                               Foreground="{StaticResource TextLightBrush}" Opacity="0.8"/>
                    <ProgressBar x:Name="PlayerHealthBar" Height="20" Width="150" 
                                 Minimum="0" Maximum="100" Value="100"
                                 Foreground="{StaticResource SuccessGreenBrush}"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="Back to Menu" Style="{StaticResource DangerButtonStyle}" 
                        Click="BackToMenu_Click" Margin="5"/>
            </Grid>
        </Border>

        <!-- Game Arena -->
        <Border Grid.Row="1" Background="#2E7D32" Margin="10" 
                BorderBrush="{StaticResource BackgroundDarkBrush}" BorderThickness="3"
                CornerRadius="5">
            <Canvas x:Name="GameCanvas" Background="#4CAF50" ClipToBounds="True" Focusable="True"/>
        </Border>

        <!-- Info Bar -->
        <Border Grid.Row="2" Background="{StaticResource AccentGradient}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Your Score: " FontSize="16" Foreground="{StaticResource TextLightBrush}" FontWeight="Bold"/>
                    <TextBlock x:Name="PlayerScoreText" Text="0" FontSize="16" Foreground="{StaticResource TextLightBrush}" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Opponent Health: " FontSize="16" Foreground="{StaticResource TextLightBrush}" FontWeight="Bold"/>
                    <ProgressBar x:Name="OpponentHealthBar" Height="20" Width="150" 
                                 Minimum="0" Maximum="100" Value="100"
                                 Foreground="{StaticResource ErrorRedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Instructions -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundDarkBrush}" Padding="10">
            <TextBlock FontSize="12" Foreground="{StaticResource TextLightBrush}" 
                       HorizontalAlignment="Center" TextAlignment="Center">
                <Run Text="🎮 WASD to move, SPACE to shoot! Destroy your opponent's tank to win! 💥"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>

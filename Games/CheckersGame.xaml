<Window x:Class="GameBox.Games.CheckersGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Checkers Online" Height="750" Width="700"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        Background="{StaticResource BackgroundLightBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="♔ Checkers Online" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Connecting..." 
                               FontSize="14" Foreground="{StaticResource TextLightBrush}" Opacity="0.9"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="New Game" Style="{StaticResource MenuButtonStyle}" 
                            Click="NewGame_Click" Margin="5"/>
                    <Button Content="Back to Menu" Style="{StaticResource DangerButtonStyle}" 
                            Click="BackToMenu_Click" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Game Board -->
        <Border Grid.Row="1" Background="White" Margin="20" 
                BorderBrush="{StaticResource PrimaryBlueBrush}" BorderThickness="3"
                CornerRadius="10">
            <Viewbox Stretch="Uniform" Margin="20">
                <Canvas x:Name="GameCanvas" Width="640" Height="640" Background="#DEB887">
                    <Canvas.Resources>
                        <!-- Board will be drawn programmatically -->
                    </Canvas.Resources>
                </Canvas>
            </Viewbox>
        </Border>

        <!-- Instructions -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundDarkBrush}" Padding="10">
            <TextBlock FontSize="12" Foreground="{StaticResource TextLightBrush}" 
                       HorizontalAlignment="Center" TextAlignment="Center">
                <Run Text="Click a piece to select it, then click a valid square to move."/>
                <LineBreak/>
                <Run Text="Jump over opponent pieces to capture them. Kings can move backwards! 🏆"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>

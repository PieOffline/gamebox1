<Window x:Class="GameBox.Games.RockPaperScissorsGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rock Paper Scissors Online" Height="650" Width="600"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        Background="{StaticResource BackgroundLightBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="✂️ Rock Paper Scissors Online" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Connecting..." 
                               FontSize="14" Foreground="{StaticResource TextLightBrush}" Opacity="0.9"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="New Round" Style="{StaticResource MenuButtonStyle}" 
                            Click="NewRound_Click" Margin="5"/>
                    <Button Content="Back to Menu" Style="{StaticResource DangerButtonStyle}" 
                            Click="BackToMenu_Click" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Game Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Score Display -->
            <Border Grid.Row="0" Background="White" Padding="20" Margin="0,0,0,20"
                    BorderBrush="{StaticResource PrimaryBlueBrush}" BorderThickness="2" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="You" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="YourScoreText" Text="0" FontSize="36" FontWeight="Bold" 
                                   Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="YourChoiceText" Text="?" FontSize="48" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="1" Text="VS" FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="30,0"/>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Opponent" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource ErrorRedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OpponentScoreText" Text="0" FontSize="36" FontWeight="Bold" 
                                   Foreground="{StaticResource ErrorRedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OpponentChoiceText" Text="?" FontSize="48" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Result Display -->
            <Border Grid.Row="1" Background="White" Padding="20" Margin="0,0,0,20"
                    BorderBrush="{StaticResource AccentOrangeBrush}" BorderThickness="2" CornerRadius="10">
                <TextBlock x:Name="ResultText" Text="Make your choice!" 
                           FontSize="28" FontWeight="Bold" TextAlignment="Center"
                           Foreground="{StaticResource PrimaryBlueBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Border>

            <!-- Choice Buttons -->
            <Border Grid.Row="2" Background="White" Padding="20"
                    BorderBrush="{StaticResource PrimaryBlueBrush}" BorderThickness="2" CornerRadius="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="RockButton" Content="🪨 Rock" Style="{StaticResource GameButtonStyle}" 
                            Click="Rock_Click" Width="150" Height="100" Margin="10" FontSize="20"/>
                    <Button x:Name="PaperButton" Content="📄 Paper" Style="{StaticResource GameButtonStyle}" 
                            Click="Paper_Click" Width="150" Height="100" Margin="10" FontSize="20"/>
                    <Button x:Name="ScissorsButton" Content="✂️ Scissors" Style="{StaticResource GameButtonStyle}" 
                            Click="Scissors_Click" Width="150" Height="100" Margin="10" FontSize="20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Info -->
        <Border Grid.Row="2" Background="{StaticResource AccentGradient}" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🎮 " FontSize="16" Foreground="{StaticResource TextLightBrush}"/>
                <TextBlock Text="Choose your move to challenge your opponent!" 
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextLightBrush}"/>
            </StackPanel>
        </Border>

        <!-- Instructions -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundDarkBrush}" Padding="10">
            <TextBlock Text="Rock crushes Scissors, Scissors cuts Paper, Paper covers Rock! 🏆" 
                       FontSize="12" Foreground="{StaticResource TextLightBrush}" 
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

<Window x:Class="GameBox.Games.SolitaireGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="♠️ Klondike Solitaire" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1a472a">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d5a3d" Padding="15" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="♠️ Klondike Solitaire" 
                           FontSize="22" FontWeight="Bold" Foreground="White" 
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="Score: " FontSize="16" Foreground="White" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScoreText" Text="0" FontSize="16" FontWeight="Bold" 
                               Foreground="#FFD700" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="New Game" 
                        Click="NewGame_Click"
                        Background="#4a7c59" Foreground="White"
                        BorderBrush="#6b9b7a" BorderThickness="2"
                        Padding="15,8" FontSize="14" FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#5a8c69"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Game Area -->
        <Canvas x:Name="GameCanvas" Grid.Row="1" Margin="10"/>
    </Grid>
</Window>

<Window x:Class="GameBox.Games.RacingGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Racing Game Online" Height="700" Width="600"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Background="{StaticResource BackgroundLightBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradient}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="🏁 Racing Game Online" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Connecting..." 
                               FontSize="14" Foreground="{StaticResource TextLightBrush}" Opacity="0.9"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0">
                    <TextBlock Text="Your Position:" FontSize="12" 
                               Foreground="{StaticResource TextLightBrush}" Opacity="0.8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PlayerPositionText" Text="0m" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="Back to Menu" Style="{StaticResource DangerButtonStyle}" 
                        Click="BackToMenu_Click" Margin="5"/>
            </Grid>
        </Border>

        <!-- Race Track -->
        <Border Grid.Row="1" Background="#424242" Margin="10" 
                BorderBrush="{StaticResource BackgroundDarkBrush}" BorderThickness="3"
                CornerRadius="5">
            <Canvas x:Name="GameCanvas" Background="#616161" ClipToBounds="True" Focusable="True">
                <!-- Track will be drawn programmatically -->
            </Canvas>
        </Border>

        <!-- Instructions -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundDarkBrush}" Padding="10">
            <TextBlock FontSize="12" Foreground="{StaticResource TextLightBrush}" 
                       HorizontalAlignment="Center" TextAlignment="Center">
                <Run Text="🎮 Use ← and → arrow keys to steer! Reach the finish line first to win! 🏆"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>
